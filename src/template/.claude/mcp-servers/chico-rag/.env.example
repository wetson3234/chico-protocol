# ============================================================
#   Chico RAG MCP — environment variables
#   Copy this file to .env and fill in your own values.
#   Never commit .env.
#
#   This MCP supports two shapes (see README.md):
#     - Shape A: local Qdrant   → set SSH_TUNNEL_ENABLED=false
#     - Shape B: remote Qdrant  → set SSH_TUNNEL_ENABLED=true and fill SSH_*
# ============================================================

# --- Qdrant connection ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=replace-me-with-your-qdrant-api-key

# --- SSH tunnel (only used when SSH_TUNNEL_ENABLED=true) ---
SSH_TUNNEL_ENABLED=false
SSH_HOST=your.vps.host.example.com
SSH_USER=your-ssh-user
# Path to your SSH private key (on Windows use forward slashes: C:/Users/you/.ssh/id_rsa)
SSH_KEY_PATH=/absolute/path/to/your/ssh/private/key
SSH_REMOTE_HOST=127.0.0.1
SSH_REMOTE_PORT=6333
SSH_LOCAL_BIND_PORT=6333

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# --- Chunking ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- Collection naming ---
# Pattern: "chico-<project-slug>" (auto-detected from the current working directory).
# Override with COLLECTION_NAME=chico-myproject if you want a fixed name.
COLLECTION_PREFIX=chico

# --- Logging ---
LOG_LEVEL=INFO
